{
  "_comment": "Capture configuration. Editing 'locations', 'models' or 'hourly' changes what future runs fetch; it does not retroactively change what check_gaps expects of past dates (each date's _manifest.json records the file list that was expected when it was captured).",

  "endpoint": "https://ensemble-api.open-meteo.com/v1/ensemble",

  "models": [
    "gfs025",
    "ecmwf_ifs025",
    "icon_seamless"
  ],

